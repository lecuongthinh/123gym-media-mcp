{
  "name": "123gym-media-mcp",
  "version": "3.9.0",
  "description": "Social Media Agent MCP for LeadConnector and ChatGPT",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "migrate": "node scripts/migrate.js",
