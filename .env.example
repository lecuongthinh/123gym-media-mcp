NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ChatGPT -> Uplifting MCP (Auth0)
AUTH0_ISSUER_BASE_URL=https://YOUR_AUTH0_TENANT.auth0.com/
AUTH0_AUDIENCE=https://uplifting-social-ai-staging.onrender.com
AUTH0_TENANT_CLAIM=https://uplifting.vn/tenant_id
MCP_RESOURCE_URL=https://uplifting-social-ai-staging.onrender.com
MCP_DOCUMENTATION_URL=https://uplifting-social-ai-staging.onrender.com/docs

# Optional internal-only legacy access. Leave disabled for customer access.
ENABLE_LEGACY_ADMIN_AUTH=false
MCP_ADMIN_API_KEY=

# Self-serve onboarding. Only enable once Auth0's own connection is
# invite-only or approval-gated -- this flag does not gate Auth0 itself.
ENABLE_SELF_SERVE_SIGNUP=false
# Built-in OAuth server (ChatGPT signs in through HighLevel; replaces Auth0). Needs migration 007.
OAUTH_SERVER_ENABLED=false
# Optional: consent page on the agency white-label domain, e.g. https://app.uplifting.vn/oauth/chooselocation
HIGHLEVEL_AUTHORIZE_URL=
# Extra redirect hosts allowed for dynamic client registration (comma separated).
OAUTH_ALLOWED_REDIRECT_HOSTS=
# Max tools/call requests per tenant per minute (in-memory, abuse guard). Default 60.
TENANT_RATE_LIMIT_PER_MINUTE=
# Inbound Webhook URL of the "Send Team Invite Email" GHL Workflow in Uplifting's
# own CRM location (not a customer's). Powers invite_team_member and the
# "email me a sign-in link" option at /oauth/authorize. Needs migration 008.
HIGHLEVEL_INVITE_WEBHOOK_URL=

# Testing Agency pilot PIT. Never paste the value into source control.
LC_PRIVATE_TOKEN_TESTING_AGENCY=

# HighLevel Marketplace OAuth onboarding
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
HIGHLEVEL_INSTALL_URL=
HIGHLEVEL_REDIRECT_URI=https://uplifting-social-ai-staging.onrender.com/oauth/callback/social-crm
TENANT_CREDENTIAL_ENCRYPTION_KEY=
